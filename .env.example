# ─────────────────────────────────────────────────────────────────────────────
# Isolation AI assistant — environment variables
# Copy to `.env` for local development; add the same keys in Vercel →
# Project → Settings → Environment Variables for production.
# NEVER commit real values. Every value below is a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the deployment (used in handoff notification links)
APP_URL=https://your-project.vercel.app

# ── Database (PostgreSQL: Supabase / Neon / Vercel Postgres) ────────────────
# Supabase: DATABASE_URL = pooled "Transaction" connection string (port 6543) + ?pgbouncer=true
#           DIRECT_URL   = direct connection string (port 5432), used for migrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Admin authentication ────────────────────────────────────────────────────
# Signs staff session cookies. Generate: openssl rand -base64 48
NEXTAUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# First admin account, created by `npm run db:seed` (only if no admin exists yet).
ADMIN_EMAIL=owner@example.com
# Only needed for the first seed — remove it afterwards. 12+ chars, upper, lower, number.
ADMIN_INITIAL_PASSWORD=

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Any chat-completions model with tool calling. Default: gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000

# ── Shopify Admin API ───────────────────────────────────────────────────────
# Store domain in myshopify form (not the custom domain)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-07
# Option A — existing custom app: Admin API access token (starts with shpat_)
SHOPIFY_ACCESS_TOKEN=
# Option B — Dev Dashboard app owned by your org: client credentials (token auto-refreshed)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ── Meta: Facebook Messenger + Instagram DMs ────────────────────────────────
META_APP_ID=
# App Settings → Basic → App secret. Used to verify X-Hub-Signature-256 on webhooks.
META_APP_SECRET=
# Any random string you choose; enter the same value in the Meta webhook settings.
META_VERIFY_TOKEN=
# Long-lived Facebook PAGE access token (Page linked to the Instagram account)
META_ACCESS_TOKEN=
# Optional: Facebook Page id (defaults to "me" = the page of the token)
META_PAGE_ID=
# Optional: only if you use "Instagram API with Instagram Login" (token starts with IG...)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0

# ── WhatsApp Business Cloud API ─────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# Any random string you choose; enter the same value in the WhatsApp webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Optional: only if WhatsApp lives in a DIFFERENT Meta app than Messenger/Instagram
WHATSAPP_APP_SECRET=

# ── Operations ──────────────────────────────────────────────────────────────
# Protects /api/cron/maintenance (Vercel Cron sends it as a Bearer token). openssl rand -hex 32
CRON_SECRET=
# Optional handoff notifications: Slack/Discord incoming webhook URL
HANDOFF_WEBHOOK_URL=
# Optional handoff emails via Resend (sent to ADMIN_EMAIL or the address set in Settings)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Isolation Bot <bot@yourdomain.com>
# debug | info | warn | error
LOG_LEVEL=info
