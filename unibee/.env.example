# ─────────────────────────────────────────────────────────────
# UniBee website settings. Copy to .env.local for local work,
# and add the same keys in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Your live domain (used for SEO tags, sitemap and share images)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ── Where registrations are saved: fill in ONE (or both) ──
# Option A: Google Sheet (see README → "Google Sheet setup")
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Option B: Supabase (see README → "Supabase setup")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Instant email for every new registration (resend.com) ──
RESEND_API_KEY=
NOTIFY_EMAIL_TO=team@your-domain.com
# Must be on a domain verified in Resend. Leave empty to use Resend's test sender.
NOTIFY_EMAIL_FROM=

# ── Admin page (/admin) ──
ADMIN_PASSWORD=choose-a-long-password
# Optional: random string; changing it logs everyone out
ADMIN_SESSION_SECRET=

# ── Tracking (leave empty to switch off) ──
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
