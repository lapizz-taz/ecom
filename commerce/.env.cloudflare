# Build settings for the Cloudflare Worker (`npm run build:cloudflare`, i.e.
# `vite build --mode cloudflare`). Public values only. The other VITE_* values
# (Supabase URL and anon key, …) are set as build variables in Cloudflare →
# Worker → Settings → Build.

# The backend functions answer on the site's own address (the Worker).
VITE_FUNCTIONS_URL=/functions/v1
# Uploads go to Cloudflare R2 through the Worker.
VITE_FILE_STORE=r2
# Clerk has its own DNS on fullfilio.com (clerk.fullfilio.com): no /__clerk relay.
VITE_CLERK_PROXY_URL=
# Clerk's production key for fullfilio.com (public; it encodes clerk.fullfilio.com).
# build:cloudflare uses this one even when a build variable has an older key.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZnVsbGZpbGlvLmNvbSQ
