{
  "name": "commerce-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Storefront + order management, inventory, production, fraud protection and finance on Supabase.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cloudflare": "tsc -b && env -u VITE_CLERK_PUBLISHABLE_KEY vite build --mode cloudflare",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --env=\"\"",
    "worker:dev": "npm run build:cloudflare && wrangler dev",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p worker/tsconfig.json",
    "lint": "tsc -b --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:convert": "node scripts/pg-to-sqlite.mjs",
    "db:seed": "jiti scripts/pg-export.ts --seed worker/db/generated/seed.sql",
    "db:e2e": "node scripts/db-e2e.mjs",
    "db:copy-e2e": "node scripts/copy-e2e.mjs",
    "build:woo-plugin": "node scripts/build-woo-plugin.mjs",
    "functions:check": "cd supabase/functions && deno check --config deno.json */index.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "5.61.3",
    "@clerk/themes": "2.4.64",
    "@fontsource/poppins": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react": "^9.47.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "goey-toast": "^0.5.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.49.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-is": "^19.3.0",
    "react-router": "^7.18.4",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "sip.js": "^0.21.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "fflate": "^0.8.2",
    "jiti": "2.7.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "^4.143.1"
  }
}
