# Edge function secrets. Local: `supabase functions serve --env-file supabase/functions/.env`
# Production: `supabase secrets set --env-file supabase/functions/.env`
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# Storefront origin(s) allowed to call the public functions (comma separated)
ALLOWED_ORIGINS=http://localhost:5173
STOREFRONT_URL=http://localhost:5173

# Shared secret for pg_cron → edge function calls (notifications, courier sync)
CRON_SECRET=change-me
NOTIFICATIONS_DISPATCH_INLINE=true

# Courier history check (Pathao / Steadfast / RedX / Paperfly parcels per phone).
# Normally connected in Settings → Fraud & advance → Courier history check, which
# tests the key and stores it encrypted in Vault. These are only a fallback.
COURIER_HISTORY_API_KEY=
COURIER_HISTORY_URL=

# Fraud provider "http" (enable it in Settings → Fraud → providers)
FRAUD_API_URL=
FRAUD_API_KEY=
FRAUD_API_AUTH_HEADER=Authorization
FRAUD_API_AUTH_SCHEME=Bearer

# SSLCommerz (enable in Settings → Payments)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Steadfast courier API + webhook
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=

# Notifications (choose providers per channel in Settings → Notifications)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_SUCCESS_PATTERN=
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Couriers are normally connected from Admin → Couriers (keys stored encrypted in
# Supabase Vault). These secrets are an optional fallback for Pathao / RedX.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_SANDBOX=false
REDX_ACCESS_TOKEN=
REDX_SANDBOX=false
