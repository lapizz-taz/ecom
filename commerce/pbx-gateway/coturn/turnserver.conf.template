# coturn for VoiceDrive softphones. Credentials are time-limited (REST API):
# the app signs "<expiry>:<agent>" with this shared secret.
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49200
external-ip=${EXTERNAL_IP}
realm=${TURN_REALM}
use-auth-secret
static-auth-secret=${TURN_SECRET}
fingerprint
no-cli
no-multicast-peers
no-tlsv1
no-tlsv1_1
cert=/certs/fullchain.pem
pkey=/certs/privkey.pem
# Never relay into private networks (stops abuse of the relay).
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
# The gateway itself is reachable (media goes to Asterisk).
allowed-peer-ip=${EXTERNAL_IP}
log-file=stdout
simple-log
