# ---- VoiceDrive gateway settings (copy to .env; never commit .env) ----

# This server's public IPv4 address (SIP and media are advertised with it).
EXTERNAL_IP=203.0.113.10
# Private ranges on this server's network (comma separated if several).
LOCAL_NET=10.0.0.0/8

# Asterisk REST Interface (only on 127.0.0.1; pick a long random password).
ARI_PASSWORD=change-me-long-random

# Supabase Postgres, read-only access for softphone logins (pbx_gw views).
# Use the session pooler (port 5432) and the user "pbx_gateway.<project-ref>".
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=pbx_gateway.your-project-ref
DB_PASSWORD=the-password-you-set-for-pbx_gateway
DB_SSLMODE=require

# The app's gateway API and the token from Super Admin → Gateway → "New gateway token".
VD_API_URL=https://your-project-ref.supabase.co/functions/v1/voicedrive
VD_GATEWAY_TOKEN=paste-the-token-shown-once

# TLS certificate for wss:// (Asterisk) and turns:// (coturn), e.g. Let's Encrypt.
TLS_DIR=/etc/letsencrypt/live/pbx.example.com

# coturn: the same secret goes into Super Admin → Gateway → TURN secret.
TURN_REALM=pbx.example.com
TURN_SECRET=change-me-at-least-16-chars

# Optional
RTP_START=10000
RTP_END=20000
SIP_PORT=5060
STUN_ADDR=
