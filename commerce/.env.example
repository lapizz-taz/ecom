# Browser configuration (copy to .env.local). Everything here is public: it is
# built into the JavaScript every visitor downloads. Never put service-role
# keys or provider secrets here; those are edge function secrets
# (supabase/functions/.env locally, the Supabase dashboard in production).
# The app reads these only through src/lib/env.ts.

# Required: the Supabase project and its anon (publishable) key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Secret entry address for the Super Admin panel, e.g. /ops-k3v9x2m7q8w1zt.
# Opening it once on a device lets that device open /super-admin; elsewhere the
# panel looks like a missing page. Empty: no secret (local development).
VITE_SUPER_ADMIN_PATH=

# Clerk sign-in for the Fullfilio site and staff pages (publishable key only;
# the secret key is a server secret, see docs/ARCHITECTURE.md → Sign-in).
# Empty: the built-in Supabase sign-in is used.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional error reporting (Sentry). Empty DSN: Sentry is not loaded at all.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_RELEASE=
