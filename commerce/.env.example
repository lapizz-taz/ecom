# Public (browser) configuration only. Never put service-role keys or provider
# secrets here — those belong in edge function secrets (supabase/functions/.env).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Hosts where / shows the Fullfilio product site instead of a store (comma-separated). Empty = never.
VITE_MARKETING_HOSTS=

# Secret entry address for the Super Admin panel, e.g. /ops-k3v9x2m7q8w1zt.
# Opening it once on a device lets that device open /super-admin; elsewhere the
# panel looks like a missing page. Empty: no secret (local development).
VITE_SUPER_ADMIN_PATH=
