// Fullfilio on Cloudflare Workers (docs/CLOUDFLARE.md walks through the setup).
//
// One Worker serves the site from Workers Static Assets (the Vite build in
// ./dist, free and not counted as Worker requests) and runs the backend
// functions for the paths in run_worker_first. The database is Supabase Postgres
// until DATABASE_BACKEND is "cloudflare" (worker/db). Secrets are never written here: set them in the dashboard
// (Worker → Settings → Variables and Secrets) or with `npx wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fullfilio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Variables set in the dashboard (FUNCTIONS_URL, PLATFORM_URL, …) survive deploys.
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Scheduled jobs (worker/cron.ts): one trigger every minute; each job keeps its own
  // schedule. They run only with DATABASE_BACKEND=cloudflare (before that, Supabase runs them).
  "triggers": { "crons": ["* * * * *"] },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths start the Worker; every other request is a static file or the app shell.
    "run_worker_first": ["/functions/*", "/__clerk", "/__clerk/*", "/oauth/*", "/files/*", "/rest/*", "/auth/*"]
  },

  "vars": {
    "SUPABASE_URL": "https://tcjdgiohmhjqppzwoztj.supabase.co",
    // The publishable (public) key: the same one built into the website.
    "SUPABASE_ANON_KEY": "sb_publishable_DOHK7YEXapzXDRpQIu67Cg_2cSNTxTC",
    // The platform's own address: links in e-mails, payment and webhook addresses, Clerk.
    "PLATFORM_URL": "https://fullfilio.com",
    "FUNCTIONS_URL": "https://fullfilio.com/functions/v1",
    "CLERK_PROXY_URL": "https://fullfilio.com/__clerk",
    "CLERK_AUTHORIZED_PARTIES": "https://fullfilio.com,https://www.fullfilio.com",
    // Merchants' own domains point here with a CNAME (Cloudflare for SaaS fallback origin).
    "CUSTOM_DOMAIN_TARGET": "stores.fullfilio.com",
    // Long-running functions stay on Supabase Edge Functions while the Worker is on
    // Workers Free (10 ms CPU, 50 outgoing requests per call). On Workers Paid set "".
    "SUPABASE_FUNCTIONS": "channels,courier,meta-ads,ad-platforms,notifications-dispatch",
    // "supabase" until the switch-over; "cloudflare" serves the database from the
    // Database Durable Object below (then SUPABASE_FUNCTIONS must be "").
    "DATABASE_BACKEND": "supabase"
  },

  // The Cloudflare database: one SQLite-backed Durable Object (worker/db). Orders, stock
  // and money live here, never in KV.
  "durable_objects": { "bindings": [{ "name": "DATABASE", "class_name": "Database" }] },
  "migrations": [{ "tag": "v1-database", "new_sqlite_classes": ["Database"] }],

  // Public, rebuildable cache entries only (Clerk's signing keys). Never orders, stock or money.
  "kv_namespaces": [{ "binding": "CACHE", "id": "bd50f9bfc46e407097966b4317f0a33f" }],

  // Product images, theme images and courier statements (Supabase Storage before).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "fullfilio-files" }],

  // fullfilio.com, www and store subdomains (<name>.fullfilio.com) run this Worker; each
  // needs a proxied DNS record (docs/CLOUDFLARE.md, step 2). Once Cloudflare for SaaS is on
  // (step 11), replace both with { "pattern": "*/*", "zone_name": "fullfilio.com" } so
  // merchants' own domains reach the Worker too ("*/*" is refused without SaaS).
  "routes": [
    { "pattern": "fullfilio.com/*", "zone_name": "fullfilio.com" },
    { "pattern": "*.fullfilio.com/*", "zone_name": "fullfilio.com" }
  ],

  "env": {
    // `npx wrangler deploy --env staging`: its own Worker, cache and files.
    // Point SUPABASE_URL at a separate (free) Supabase project, never the live one.
    "staging": {
      "name": "fullfilio-staging",
      // SUPABASE_URL is set in the dashboard (it is kept across deploys).
      "vars": { "SUPABASE_FUNCTIONS": "", "DATABASE_BACKEND": "cloudflare" },
      "durable_objects": { "bindings": [{ "name": "DATABASE", "class_name": "Database" }] },
      "kv_namespaces": [{ "binding": "CACHE", "id": "e28a2bd7b9114f41a72f7ee9defd3b5c" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "fullfilio-files-staging" }]
    }
  }
}
