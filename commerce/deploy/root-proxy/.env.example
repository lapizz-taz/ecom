# Copy to .env and fill in.
# Where Let's Encrypt sends certificate notices.
ACME_EMAIL=you@example.com
# The Fullfilio site (asked before every new certificate).
FULLFILIO_SITE=https://fullfilio.com
# Fullfilio's custom-domain target on Cloudflare (CUSTOM_DOMAIN_TARGET).
UPSTREAM_HOST=stores.fullfilio.com
# A long random secret, the same as the Worker secret ROOT_PROXY_SECRET (openssl rand -hex 32).
PROXY_SECRET=
